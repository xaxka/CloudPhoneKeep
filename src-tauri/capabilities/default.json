[
  {
    "identifier": "default",
    "description": "设置窗口与浏览器窗口的基础能力",
    "windows": ["login", "browser-*"],
    "permissions": [
      "core:default",
      "core:window:default",
      "core:webview:default",
      "core:event:default",
      "core:app:default",
      "core:window:allow-hide",
      "core:window:allow-show",
      "core:window:allow-set-focus"
    ]
  }
]
